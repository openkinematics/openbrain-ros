# Dev image — same packages as the Jetson image, but x86_64 + interactive
# tooling (vim, htop, gdb, ripgrep, ros2 cli completion, jq, etc.). Used by
# `make dev` and the devcontainer.
#
# We deliberately do NOT base on JetPack here: developer laptops are usually
# x86 Linux or macOS Docker Desktop, where l4t-jetpack won't run.

FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    ROS_DISTRO=humble \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

RUN apt-get update && apt-get install -y --no-install-recommends \
        locales build-essential cmake git pkg-config curl ca-certificates \
        python3-pip python3-venv python3-dev \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-cv-bridge ros-humble-vision-msgs ros-humble-image-transport \
        ros-humble-rosbridge-suite \
        ros-humble-nav2-bringup ros-humble-rtabmap-ros \
        ros-humble-ros-gz ros-humble-ros-gz-bridge ros-humble-ros-gz-sim \
        ros-humble-joy ros-humble-tf2-tools ros-humble-tf2-ros \
        ros-humble-diagnostic-updater ros-humble-diagnostic-msgs \
        python3-colcon-common-extensions python3-rosdep python3-vcstool \
        vim less htop tmux jq ripgrep tree shellcheck clang-format-15 \
    && locale-gen en_US.UTF-8 \
    && rosdep init || true \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
        aiohttp==3.9.5 aiortc==1.15.0 av==17.1.0 \
        psutil==5.9.8 requests==2.31.0 \
        ruff==0.5.5 pre-commit pyyaml zeroconf

WORKDIR /workspace
COPY . /workspace

RUN . /opt/ros/humble/setup.sh \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -y \
        --skip-keys "fastcdr rti-connext-dds-6.0.1 urdfdom_headers librealsense2 ros-humble-realsense2-camera ros-humble-realsense2-camera-msgs jetson-stats" \
        || true \
    && echo "source /opt/ros/humble/setup.bash" >> /etc/bash.bashrc \
    && echo "[ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash" >> /etc/bash.bashrc \
    && echo "alias ll='ls -lah'" >> /etc/bash.bashrc

EXPOSE 9090 8080 8090
CMD ["bash", "-l"]
