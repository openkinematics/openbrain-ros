<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_demos_vslam_gps_denied</name>
  <version>0.1.0</version>
  <description>RTAB-Map RGB-D + IMU configuration tuned for GPS-denied
  environments (warehouses, basements, indoor drone flight). Loop
  closures + VIO compensate for the lack of GNSS.</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>openbrain_slam</exec_depend>
  <exec_depend>openbrain_drivers_realsense</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
