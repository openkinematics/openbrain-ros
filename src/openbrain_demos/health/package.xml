<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_demos_health</name>
  <version>0.1.0</version>
  <description>Publishes Jetson telemetry on /system/health (CPU, GPU, RAM,
  thermal, power) at 1 Hz. Real implementation.</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>openbrain_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
