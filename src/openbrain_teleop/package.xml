<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_teleop</name>
  <version>0.1.0</version>
  <description>Teleoperation surface area for the dashboard:
    * rosbridge_server WebSocket on :9090
    * HTTP video streamer on :8080 with WebRTC (POST /stream/{name}/offer)
      and MJPEG fallback (GET /stream/{name}.mjpeg)</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-aiohttp</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
