<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_robots_generic</name>
  <version>0.1.0</version>
  <description>Generic pass-through robot adapter and the RobotAdapter base class
  that vendor adapters extend. Use this for any ROS 2-native robot that
  already consumes /cmd_vel and publishes /odom on its own.</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>openbrain_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
