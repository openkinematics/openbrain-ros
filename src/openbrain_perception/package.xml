<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_perception</name>
  <version>0.1.0</version>
  <description>Perception entry points: YOLO detector (delegates to the
  openbrain_demos_yolo_perception implementation) and an NVBlox
  3D-mapping bridge scaffold.</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>openbrain_demos_yolo_perception</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
