<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_slam</name>
  <version>0.1.0</version>
  <description>RTAB-Map configuration and launch for OpenBrain. Indoor mobile
  robot defaults; consumes /camera/front/{color,depth} and /odom and emits
  /map plus a TF tree rooted at "map".</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
