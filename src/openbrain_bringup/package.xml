<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files for the Kinematics Mini and Max boxes.
  Detects robot type and includes the right adapter, drivers, SLAM, Nav2,
  and teleop bridges.</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>openbrain_drivers_realsense</exec_depend>
  <exec_depend>openbrain_slam</exec_depend>
  <exec_depend>openbrain_nav</exec_depend>
  <exec_depend>openbrain_teleop</exec_depend>
  <exec_depend>openbrain_connector</exec_depend>
  <exec_depend>openbrain_robots_generic</exec_depend>
  <exec_depend>openbrain_robots_unitree_go2</exec_depend>
  <exec_depend>openbrain_robots_unitree_g1</exec_depend>
  <exec_depend>openbrain_robots_tita</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
