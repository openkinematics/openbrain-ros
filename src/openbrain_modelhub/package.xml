<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openbrain_modelhub</name>
  <version>0.1.0</version>
  <description>Pulls trained RL / VLA policies from the OpenKinematics
  Model Hub SaaS into /opt/openbrain/models on the edge box.</description>
  <maintainer email="opensource@openkinematics.com">OpenKinematics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>python3-requests</depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
